<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Dizzy.Gamma</AssemblyName>
    <Product>Dizzy Gamma</Product>
    <Version>0.1.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Override: dotnet build -p:SailwindDir=C:\path\to\Sailwind -->
    <SailwindDir Condition="'$(SailwindDir)' == ''">D:\SteamLibrary\steamapps\common\Sailwind</SailwindDir>
    <BepInExPluginsDir>$(SailwindDir)\BepInEx\plugins</BepInExPluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="UnityEngine.Modules" Version="2019.1.10" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="DeployToSailwind" AfterTargets="Build" Condition="'$(DeployOnBuild)' != 'false' And Exists('$(BepInExPluginsDir)')">
    <RemoveDir Directories="$(BepInExPluginsDir)\Dizzy.HelloWorld" Condition="Exists('$(BepInExPluginsDir)\Dizzy.HelloWorld')" />
    <MakeDir Directories="$(BepInExPluginsDir)\Dizzy.Gamma" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExPluginsDir)\Dizzy.Gamma" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="Deployed $(TargetFileName) → $(BepInExPluginsDir)\Dizzy.Gamma\" />
  </Target>

</Project>
